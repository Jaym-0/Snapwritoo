# Copy this file to .env.local

# --- Admin panel ---
# Set your own secret before deploying anywhere public. Without this, the
# admin panel falls back to the token "snapwritoo-dev" — fine for local use,
# not safe to expose publicly.
ADMIN_TOKEN=change-me-to-something-long-and-random

# --- Database (optional locally, required once deployed) ---
# Leave these two blank/unset for local development — the app will use a
# local SQLite file at data/snapwritoo.db automatically, no setup needed.
#
# Once you deploy (Vercel, etc.), a local file won't persist between
# requests, so set these to a free hosted database from https://turso.tech:
#   1. Sign up, then `turso db create snapwritoo` (or use the web dashboard)
#   2. `turso db show snapwritoo --url`        → TURSO_DATABASE_URL
#   3. `turso db tokens create snapwritoo`     → TURSO_AUTH_TOKEN
# Paste both into your host's environment variables (and here for local
# testing against the hosted DB too, if you want).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

